# /server/.env
PORT=3001

MONGODB_URI=mongodb://localhost:27017/leettrace

# Tip: with Chrome logged into leetcode.com, run `pnpm leetcode:auth` to fill
# these two automatically (pulls the cookies straight from Chrome's keyring).
LEETCODE_SESSION=your_session_cookie_here
CSRF_TOKEN=your_csrf_token_here

OPENAI_API_KEY=your_openrouter_or_deepseek_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1 # Or DeepSeek URL
OPENAI_MODEL=deepseek/deepseek-chat # OpenRouter/DeepSeek model id for the AI assistant
